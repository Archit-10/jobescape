# Copy to ".env" only if you want to change something. Defaults work out of the box.
#   cp .env.example .env

# --- Where it listens ---
# 127.0.0.1 = only THIS computer can open it (recommended, private).
# 0.0.0.0   = anyone on your network can open it. There is no login, so only do this on a network you trust.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Address your browser uses. Change only if you open the app from another device,
# e.g. PUBLIC_HOST=192.168.1.20 (and BIND_ADDRESS=0.0.0.0). Then run: docker compose up -d --build
PUBLIC_HOST=localhost

# --- Scraper behaviour ---
# Jobs running at once (extra searches wait in a queue).
MAX_CONCURRENT_JOBS=2
# Simultaneous requests inside one search. Lower = gentler on job sites and your RAM.
MAX_PARALLEL_TASKS=12
# Cap on site x location x search-term requests per search.
MAX_TASKS_PER_JOB=150
MAX_RESULTS_PER_SITE=100
# How long finished results stay available (seconds).
JOB_TTL_SECONDS=3600

# --- Optional: rotating proxies, comma-separated (user:pass@host:port,...) ---
# Job sites block heavy use from one IP. NOTE: your searches then pass through the proxy provider.
SCRAPER_PROXIES=